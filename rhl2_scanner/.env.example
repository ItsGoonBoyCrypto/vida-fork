# Copy to .env (never commit — .env is gitignored). The scanner auto-loads it.
# These override anything in the YAML config.

# --- Telegram (only needed to actually SEND alerts; dry-run/paper don't need it) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- Chain / data sources ---
# Explorer (Etherscan-style) API key — Basescan for Base, RH L2 explorer later.
RHL2_EXPLORER_API_KEY=
# Override RPC / explorer base if not set in YAML:
RHL2_RPC_URL=
RHL2_EXPLORER_API_URL=

# --- Exact-tax simulator runtime bytecode (optional) ---
# solc --optimize --bin-runtime --evm-version paris \
#   rhl2_scanner/contracts/HoneypotSimulator.sol
RHL2_SIMULATOR_BYTECODE=

# --- Optional: DEX addresses to enable honeypot sim + earliest pool detection ---
# Grab from robinhoodchain.blockscout.com (search "Wrapped Ether",
# "UniswapV2Factory", "UniswapV2Router"). Safe to leave blank.
RHL2_WETH_ADDRESS=
RHL2_DEX_FACTORY=
RHL2_DEX_ROUTER=
# RHL2_DEX_FACTORY_KIND=univ2   # or univ3

# --- Misc ---
# RHL2_DRY_RUN=true
